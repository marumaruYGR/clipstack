{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "剪栈",
  "version": "1.1.0",
  "identifier": "cn.siyanghuasangou.clipstack",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "publisher": "四氧化三狗",
    "shortDescription": "Windows 剪贴板历史与加密收藏",
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper", "silent": true },
      "nsis": {
        "installMode": "both",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false,
        "template": "installer.nsi",
        "installerIcon": "icons/icon.ico",
        "sidebarImage": "icons/installer-sidebar.bmp"
      }
    }
  }
}
